#!/usr/bin/env bash
#
# Determines if the Global Protect VPN is connected by checking the launchctl 
# service status and optionally reading the UI for IP information.
#
# - 0: GlobalProtect's VPN service is loaded and an IPv4 utun carries the default route.
# - 1: No IPv4 utun interface was detected.
# - 2: A utun exists but routing/service state cannot confirm GlobalProtect (for
#      example, split tunneling or another utun-based service).
#

main() {
  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Usage: gpstatus [-h|--help]"
    echo "Checks VPN routing using native macOS networking tools."
    echo "Exit 0: GlobalProtect service is loaded and default route uses IPv4 utun; exit 1: no IPv4 utun detected; exit 2: utun found but GlobalProtect status is ambiguous."
    exit 0
  fi

  echo "=== GlobalProtect VPN Status ==="
  
  # Check whether the GlobalProtect services are loaded.
  if launchctl list | grep -Fq "com.paloaltonetworks.gp.pangpa"; then
    pangpa_loaded=true
  else
    pangpa_loaded=false
  fi
  if launchctl list | grep -Fq "com.paloaltonetworks.gp.pangps"; then
    pangps_loaded=true
  else
    pangps_loaded=false
  fi
  
  echo "GlobalProtect GUI service (pangpa): $([[ "$pangpa_loaded" == "true" ]] && echo "loaded" || echo "not loaded")"
  echo "GlobalProtect VPN service (pangps): $([[ "$pangps_loaded" == "true" ]] && echo "loaded" || echo "not loaded")"
  
  # Check default route to see if it goes through a utun interface (VPN)
  default_route=$(route -n get default 2>/dev/null)
  vpn_interface=""
  vpn_gateway=""
  
  if echo "$default_route" | grep -q "interface: utun"; then
    vpn_interface=$(echo "$default_route" | awk '/interface:/ {print $2}')
    vpn_gateway=$(echo "$default_route" | awk '/gateway:/ {print $2}')
    
    # Get the VPN IP address assigned to this interface
    vpn_ip=$(ifconfig "$vpn_interface" 2>/dev/null | awk '/inet / && !/inet6/ {print $2}' | head -1)
    
    if [[ -n "$vpn_ip" ]]; then
      if [[ "$pangps_loaded" != "true" ]]; then
        echo ""
        echo "⚠️  The default route uses $vpn_interface, but the GlobalProtect VPN service is not loaded."
        echo "   Another utun-based service may own this route; GlobalProtect status is ambiguous."
        exit 2
      fi
      echo ""
      echo "✅ GlobalProtect VPN is CONNECTED"
      echo "   Interface: $vpn_interface"
      echo "   VPN IP: $vpn_ip"
      if [[ -n "$vpn_gateway" ]]; then
        echo "   Gateway: $vpn_gateway"
      fi
      
      # Get MTU and additional interface info
      mtu=$(ifconfig "$vpn_interface" 2>/dev/null | awk '/mtu/ {print $NF}')
      echo "   MTU: ${mtu:-unknown}"
      
      # Show DNS servers if configured for this interface
      dns_info=$(scutil --dns 2>/dev/null | grep -A 10 "resolver #.*$vpn_interface" | grep "nameserver" | head -3)
      if [[ -n "$dns_info" ]]; then
        echo "   DNS servers:"
        printf '%s\n' "$dns_info" | awk '{print "     " $0}'
      fi
      
      exit 0
    fi
  fi
  
  # Check for any utun interfaces with IPv4 addresses (backup method)
  echo ""
  echo "Checking all utun interfaces for VPN connections..."
  utun_found=false
  
  for interface in $(ifconfig | awk '/^utun/ {print $1}' | sed 's/://'); do
    ip=$(ifconfig "$interface" 2>/dev/null | awk '/inet / && !/inet6/ {print $2}' | head -1)
    if [[ -n "$ip" ]]; then
      echo "   $interface: $ip"
      utun_found=true
    fi
  done
  
  if [[ "$utun_found" == "true" ]]; then
    echo ""
    echo "⚠️  utun interface(s) found, but the default route is elsewhere."
    echo "   This may be a split-tunnel VPN or another utun-based service; status is ambiguous."
    exit 2
  fi
  
  # If no VPN detected
  echo ""
  if [[ "$pangps_loaded" == "true" ]]; then
    echo "❌ VPN service is loaded but NOT connected"
  else
    echo "❌ VPN is NOT connected and service is not loaded"
  fi
  
  exit 1
}

main "$@"
